rules_version = '2';
// Widebed Owner Portal (its OWN Firebase project, not widebed-pmsdashboard). Draft 1.0, 26 Nov 2026.
// The browser never reads or writes this database. The only document kept here is ownerLinks/{uid} (which PMS owner a portal
// login belongs to), written and read by the server functions with the project's service account, which bypasses these rules.
// So every client request is refused, signed in or not. An owner's data is never in this project at all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
